# Copia a .env y rellena. .env NO se sube (ver .gitignore).

# --- Base de datos ---
CLARITY_DB_PATH=data/clarity.db

# --- API ---
CLARITY_API_HOST=127.0.0.1
CLARITY_API_PORT=8000
# URL que usa el dashboard Streamlit para llamar a la API
CLARITY_API_URL=http://127.0.0.1:8000

# --- Azure OpenAI (insights). Si vacio -> insights usan plantilla local (sin LLM). ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01
# Region fijada por RGPD
AZURE_OPENAI_REGION=swedencentral

# --- Clasificador ---
# Forzar mock aunque exista models/load_classifier.py (util para demos y CI)
USE_MOCK_CLASSIFIER=false

# --- Anonimizacion ---
# es_core_news_md | es_core_news_sm  (modelo spacy para Presidio)
PRESIDIO_SPACY_MODEL=es_core_news_md
